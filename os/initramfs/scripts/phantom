#!/bin/sh
# initramfs-tools boot script, selected with boot=phantom on the kernel command
# line. Copies the compressed root into memory, releases the boot medium, and
# builds a writable overlay on top of it. See ADR 0003.
#
# shellcheck shell=dash
# Runs under busybox ash, which supports 'local'. initramfs-tools provides
# 'rootmnt', 'panic' and the functions file.
# shellcheck disable=SC3043,SC2154

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

# shellcheck source=/dev/null
. /scripts/functions

PHANTOM_LABEL=PHANTOMMC
PHANTOM_IMAGE=/phantom/root.squashfs
PHANTOM_KEEP_MEDIUM=0

MEDIUM=/run/phantom/medium
RAM=/run/phantom/ram
LOWER=/run/phantom/lower
UPPER=/run/phantom/upper

parse_cmdline() {
	cmdline=$(cat /proc/cmdline)
	for arg in $cmdline; do
		case "$arg" in
		phantom.label=*) PHANTOM_LABEL="${arg#phantom.label=}" ;;
		phantom.image=*) PHANTOM_IMAGE="${arg#phantom.image=}" ;;
		phantom.keepmedium) PHANTOM_KEEP_MEDIUM=1 ;;
		esac
	done
}

say() {
	printf '\n[ phantom ] %s\n' "$1" >/dev/console
}

fail() {
	say "$1"
	panic "$1"
}

load_modules() {
	for mod in loop squashfs overlay isofs vfat ext4; do
		modprobe "$mod" 2>/dev/null || true
	done
	if command -v udevadm >/dev/null 2>&1; then
		udevadm settle --timeout=10 2>/dev/null || true
	fi
}

# A stick written with a plain file copy keeps whatever label it already had, so
# the label is only a fast path. The authoritative test is whether a device
# actually carries the payload.
carries_payload() {
	mount -t auto -o ro "$1" "$MEDIUM" 2>/dev/null || return 1
	if [ -f "${MEDIUM}${PHANTOM_IMAGE}" ]; then
		return 0
	fi
	umount "$MEDIUM" 2>/dev/null || true
	return 1
}

candidate_devices() {
	if [ -e "/dev/disk/by-label/${PHANTOM_LABEL}" ]; then
		readlink -f "/dev/disk/by-label/${PHANTOM_LABEL}"
	fi
	blkid -o device 2>/dev/null || true
	awk 'NR>2 && $4 !~ /^(ram|loop|zram)/ {print "/dev/" $4}' /proc/partitions
}

# Leaves the medium mounted at $MEDIUM on success and echoes the device.
find_medium() {
	local waited=0 device seen

	while [ "$waited" -lt 45 ]; do
		seen=""
		for device in $(candidate_devices); do
			case " $seen " in
			*" $device "*) continue ;;
			esac
			seen="$seen $device"

			[ -b "$device" ] || continue
			if carries_payload "$device"; then
				echo "$device"
				return 0
			fi
		done

		if [ "$waited" -eq 0 ]; then
			say "waiting for a boot medium carrying ${PHANTOM_IMAGE}"
		fi
		sleep 1
		waited=$((waited + 1))
	done

	say "devices seen: $(candidate_devices | tr '\n' ' ')"
	return 1
}

copy_to_ram() {
	local src="$1" dst="$2" size
	size=$(stat -c %s "$src")
	say "copying $((size / 1048576)) MiB into memory"
	mount -t tmpfs -o "size=$((size + 8388608)),mode=0755" tmpfs "$RAM"
	cp "$src" "$dst"
	sync
}

mountroot() {
	parse_cmdline
	mkdir -p "$MEDIUM" "$RAM" "$LOWER" "$UPPER"
	load_modules

	local device
	device=$(find_medium) || fail "no boot medium carrying ${PHANTOM_IMAGE}"
	say "found boot medium on ${device}"

	copy_to_ram "${MEDIUM}${PHANTOM_IMAGE}" "${RAM}/root.squashfs"

	if [ "$PHANTOM_KEEP_MEDIUM" -eq 0 ]; then
		umount "$MEDIUM" || fail "cannot release boot medium"
		say "boot medium released, the drive can be removed now"
	fi

	mount -t squashfs -o ro,loop "${RAM}/root.squashfs" "$LOWER" \
		|| fail "cannot mount root image"

	mount -t tmpfs -o mode=0755 tmpfs "$UPPER"
	mkdir -p "${UPPER}/data" "${UPPER}/work"

	mount -t overlay overlay \
		-o "lowerdir=${LOWER},upperdir=${UPPER}/data,workdir=${UPPER}/work" \
		"${rootmnt}" || fail "cannot stack overlay"

	say "root is in memory"
}
