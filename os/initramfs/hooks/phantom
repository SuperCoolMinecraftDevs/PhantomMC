#!/bin/sh
# shellcheck shell=dash
# initramfs-tools exports 'version' and provides hook-functions.
# shellcheck disable=SC2154
set -e

PREREQ=""
prereqs() { echo "$PREREQ"; }
case "$1" in
prereqs)
	prereqs
	exit 0
	;;
esac

# shellcheck source=/dev/null
. /usr/share/initramfs-tools/hook-functions

copy_exec /sbin/losetup
copy_exec /sbin/blkid
copy_exec /bin/mountpoint

for mod in squashfs overlay loop isofs vfat nls_ascii nls_cp437; do
	manual_add_modules "$mod"
done

add_loadmodules_from_dir() {
	[ -d "$1" ] || return 0
	find "$1" -name '*.ko*' -printf '%f\n' | sed 's/\.ko.*$//' | while read -r m; do
		manual_add_modules "$m"
	done
}

add_loadmodules_from_dir "/lib/modules/${version}/kernel/drivers/usb/storage"
add_loadmodules_from_dir "/lib/modules/${version}/kernel/drivers/ata"
